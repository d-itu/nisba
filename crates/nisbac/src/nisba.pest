Doc     =  { SOI ~ Typedef* ~ EOI }
Typedef = _{ Primitive | Tuple | Union }

Primitive = ${ "@primitive" ~ ws+ ~ typename ~ ws* ~ builtin }

Tuple  =  { (Struct | Packed) ~ typename ~ "{" ~ Member* ~ "}" }
Struct = @{ "@struct" ~ ws+ }
Packed = @{ "@packed" ~ ws+ }

Union = { (Enum | Dict) ~ "(" ~ Unsigned ~ ")" ~ typename ~ "{" ~ TaggedMember* ~ "}" }
Enum  = { "@enum" }
Dict  = { "@dict" }

typename = _{ !(builtin ~ ("{" | ws)) ~ Ident }
builtin  = _{ Void | Signed | Unsigned }

Member       = { Ident ~ ":" ~ Type }
TaggedMember = { Ident ~ (":" ~ Type)? ~ ("=" ~ Number)? }

Type   =  { Array | VarintSigned | VarintUnsigned | builtin | typename }
Array  =  { (Vector | Stream) ~ "(" ~ Length ~ Type ~ ")" }
Vector =  { "@vector" }
Stream =  { "@stream" }
Length = _{ Unsigned | VarintUnsigned }

VarintSigned   =  { "@varint" ~ "(" ~ Signed ~ ")" }
VarintUnsigned =  { "@varint" ~ "(" ~ Unsigned ~ ")" }
Signed         = ${ "i" ~ Dec }
Unsigned       = ${ "u" ~ Dec }
Void           =  { "void" }

Number     =  { Bin | Hex | Dec }
Bin        = @{ "0b" ~ ASCII_BIN_DIGIT+ }
Hex        = @{ "0x" ~ ASCII_HEX_DIGIT+ }
Dec        = @{ "0" | NonZeroDec }
NonZeroDec = @{ ASCII_NONZERO_DIGIT ~ ASCII_DIGIT* }

Ident = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }

ws         = _{ " " | "\r" | "\n" | "\t" }
WHITESPACE = _{ ws }
COMMENT    = _{ "//" ~ (!"\n" ~ ANY)* }
